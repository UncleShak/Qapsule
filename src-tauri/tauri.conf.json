{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qapsule",
  "version": "0.0.1",
  "identifier": "com.qynetik.qapsule",
  "build": {
    "beforeDevCommand": "bun run --cwd ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qapsule",
        "width": 1100,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
